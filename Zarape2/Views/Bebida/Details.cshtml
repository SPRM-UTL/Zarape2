@model Zarape2.Models.Bebida

<h2>Detalles de la Bebida</h2>
<hr />

<div class="card shadow-sm mt-3" style="max-width: 600px;">
    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Información del Producto</h4>
    </div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">ID:</dt>
            <dd class="col-sm-8">@Model.Id</dd>

            <dt class="col-sm-4">Nombre:</dt>
            <dd class="col-sm-8"><strong>@Model.Nombre</strong></dd>

            <dt class="col-sm-4">Descripción:</dt>
            <dd class="col-sm-8 text-muted">
                @(string.IsNullOrEmpty(Model.Descripcion) ? "Sin descripción disponible." : Model.Descripcion)
            </dd>

            <dt class="col-sm-4">Precio:</dt>
            <dd class="col-sm-8 text-success fw-bold">@Model.Precio.ToString("C")</dd>

            <dt class="col-sm-4">Estado:</dt>
            <dd class="col-sm-8">
                @if (Model.Disponible)
                {
                    <span class="badge bg-success">Disponible para la Venta</span>
                }
                else
                {
                    <span class="badge bg-secondary">Agotada / Fuera de Menú</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
        Editar Información
    </a>
    
    <a asp-action="Index" class="btn btn-secondary">
        Volver al Menú
    </a>
</div>