@model List<Zarape2.Models.Usuario>

<h2>Usuarios</h2>

<p>
    <a asp-action="Create" class="btn btn-success">
        Nuevo Usuario
    </a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nombre</th>
            <th>Usuario</th>
            <th>Rol</th>
            <th>Sucursal</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nombre</td>
                <td>@item.UsuarioLogin</td>
                <td>@item.Rol</td>
                <td>@item.SucursalId</td>
                <td>
                    @(item.Activo ? "Activo" : "Desactivado")
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">
                        Ver
                    </a>

                    |

                    <a asp-action="Edit" asp-route-id="@item.Id">
                        Editar
                    </a>

                    |

                    @if (item.Activo)
                    {
                        <a asp-action="Delete" asp-route-id="@item.Id">
                            Desactivar
                        </a>
                    }
                    else
                    {
                        <a asp-action="Activar" asp-route-id="@item.Id">
                            Activar
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>