@model Zarape2.Models.Usuario

<h2>Nuevo Usuario</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label>Nombre</label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Usuario</label>
        <input asp-for="UsuarioLogin" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Contraseña</label>
        <input asp-for="Password" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Rol</label>
        <input asp-for="Rol" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Sucursal</label>
        <input asp-for="SucursalId" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Guardar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Regresar
    </a>

</form>