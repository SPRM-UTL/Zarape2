@model Zarape2.Models.Usuario

<h2>Detalle del Usuario</h2>

<hr />

<p><strong>Id:</strong> @Model.Id</p>
<p><strong>Nombre:</strong> @Model.Nombre</p>
<p><strong>Usuario:</strong> @Model.UsuarioLogin</p>
<p><strong>Rol:</strong> @Model.Rol</p>
<p><strong>Sucursal:</strong> @Model.SucursalId</p>
<p><strong>Estado:</strong> @(Model.Activo ? "Activo" : "Desactivado")</p>

<a asp-action="Index" class="btn btn-secondary">
    Regresar
</a>