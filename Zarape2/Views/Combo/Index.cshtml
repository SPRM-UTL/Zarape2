@model List<Zarape2.Models.Combo>

@{
    ViewData["Title"] = "Combos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary">
            Regresar
        </a>

        <h2 class="mb-0">
            Registro de Combos
        </h2>

        <button type="button"
                class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#modalCombo">
            Nuevo Combo
        </button>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            Lista de Combos
        </div>

        <div class="card-body">

            <table class="table table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Precio</th>
                        <th>Disponible</th>
                        <th>Productos</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var combo in Model)
                    {
                        <tr>

                            <td>@combo.Id</td>

                            <td>@combo.Nombre</td>

                            <td>@combo.Descripcion</td>

                            <td>
                                $@combo.Precio.ToString("N2")
                            </td>

                            <td>

                                @if (combo.Disponible)
                                {
                                    <span class="badge bg-success">
                                        Disponible
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        No Disponible
                                    </span>
                                }

                            </td>

                            <td>
                                @(combo.Alimentos.Count +
                                  combo.Bebidas.Count)
                            </td>

                            <td>

                                <button class="btn btn-info btn-sm"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#detalle_@combo.Id">
                                    Ver Detalle
                                </button>

                            </td>

                        </tr>

                        <tr class="collapse"
                            id="detalle_@combo.Id">

                            <td colspan="7">

                                <div class="card">

                                    <div class="card-header">
                                        Componentes del Combo
                                    </div>

                                    <div class="card-body">

                                        <h5>Alimentos</h5>

                                        <table class="table table-bordered">

                                            <thead>
                                                <tr>
                                                    <th>Nombre</th>
                                                    <th>Cantidad</th>
                                                </tr>
                                            </thead>

                                            <tbody>

                                                @foreach (var item in combo.Alimentos)
                                                {
                                                    <tr>
                                                        <td>
                                                            @item.Alimento.Nombre
                                                        </td>

                                                        <td>
                                                            @item.Cantidad
                                                        </td>
                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                        <h5>Bebidas</h5>

                                        <table class="table table-bordered">

                                            <thead>
                                                <tr>
                                                    <th>Nombre</th>
                                                    <th>Cantidad</th>
                                                </tr>
                                            </thead>

                                            <tbody>

                                                @foreach (var item in combo.Bebidas)
                                                {
                                                    <tr>
                                                        <td>
                                                            @item.Bebida.Nombre
                                                        </td>

                                                        <td>
                                                            @item.Cantidad
                                                        </td>
                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<div class="modal fade"
     id="modalCombo"
     tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <form asp-action="Agregar"
                  method="post">
                <div class="modal-header">
                    <h5 class="modal-title">
                        Nuevo Combo
                    </h5>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-4">
                            <label>Nombre</label>
                            <input type="text"
                                   name="Nombre"
                                   class="form-control"
                                   required />
                        </div>
                        <div class="col-md-4">
                            <label>Precio</label>
                            <input type="number"
                                   step="0.01"
                                   id="Precio"
                                   name="Precio"
                                   class="form-control"
                                   readonly
                                   required />
                        </div>
                        <div class="col-md-4">
                            <label>Disponible</label>
                            <select name="Disponible"
                                    class="form-select">
                                <option value="true">
                                    Sí
                                </option>
                                <option value="false">
                                    No
                                </option>
                            </select>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label>Descripción</label>
                        <textarea name="Descripcion"
                                  class="form-control">
                        </textarea>
                    </div>
                    <hr/>
                    <h5>Alimentos</h5>
                    <table class="table"
                           id="tablaAlimentos">
                        <thead>
                            <tr>
                                <th>Alimento</th>
                                <th>Cantidad</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <button type="button"
                            class="btn btn-primary"
                            onclick="agregarAlimento()">
                        Agregar Alimento
                    </button>
                    <hr/>
                    <h5>Bebidas</h5>
                    <table class="table"
                           id="tablaBebidas">
                        <thead>
                            <tr>
                                <th>Bebida</th>
                                <th>Cantidad</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                    <button type="button"
                            class="btn btn-primary"
                            onclick="agregarBebida()">
                        Agregar Bebida
                    </button>
                </div>
                <div class="modal-footer">
                    <button type="submit"
                            class="btn btn-success">
                        Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>

    let indiceAlimento = 0;
    let indiceBebida = 0;

    const alimentos = [
        @foreach (var item in ViewBag.Alimentos)
        {
            @:{ id:@item.Id, nombre:"@item.Nombre", precio:@item.Precio },
        }
    ];

    const bebidas = [
        @foreach (var item in ViewBag.Bebidas)
        {
            @:{ id:@item.Id, nombre:"@item.Nombre", precio:@item.Precio },
        }
    ];

    function agregarAlimento()
    {
        let opciones = "";

        alimentos.forEach(a =>
        {
            opciones += `
                <option value="${a.id}">
                    ${a.nombre}
                </option>
            `;
        });

        let fila = document.createElement("tr");

        fila.innerHTML = `
            <td>

                <select class="form-select"
                        name="Alimentos[${indiceAlimento}].AlimentoId"
                        onchange="calcularPrecioCombo()">

                    ${opciones}

                </select>

            </td>

            <td>

                <input type="number"
                       class="form-control"
                       name="Alimentos[${indiceAlimento}].Cantidad"
                       value="1"
                       min="1"
                       oninput="calcularPrecioCombo()"
                       required />

            </td>

            <td>

                <button type="button"
                        class="btn btn-danger"
                        onclick="eliminarFila(this)">
                    X
                </button>

            </td>
        `;

        document
            .querySelector("#tablaAlimentos tbody")
            .appendChild(fila);

        indiceAlimento++;
        calcularPrecioCombo()
    }

    function agregarBebida()
    {
        let opciones = "";

        bebidas.forEach(b =>
        {
            opciones += `
                <option value="${b.id}">
                    ${b.nombre}
                </option>
            `;
        });

        let fila = document.createElement("tr");

        fila.innerHTML = `
            <td>

                <select class="form-select"
                        name="Bebidas[${indiceBebida}].BebidaId"
                        onchange="calcularPrecioCombo()">

                    ${opciones}

                </select>

            </td>

            <td>

                <input type="number"
                       class="form-control"
                       name="Bebidas[${indiceBebida}].Cantidad"
                       value="1"
                       min="1"
                       oninput="calcularPrecioCombo()"
                       required />

            </td>

            <td>

                <button type="button"
                        class="btn btn-danger"
                        onclick="eliminarFila(this)">
                    X
                </button>

            </td>
        `;

        document
            .querySelector("#tablaBebidas tbody")
            .appendChild(fila);

        indiceBebida++;
        calcularPrecioCombo()
    }

    function eliminarFila(btn)
    {
        btn.closest("tr").remove();
        calcularPrecioCombo();
    }

    function calcularPrecioCombo()
    {
        let total = 0;

        document.querySelectorAll("#tablaAlimentos tbody tr")
            .forEach(fila =>
            {
                let alimentoId =
                    parseInt(
                        fila.querySelector("select").value
                    );

                let cantidad =
                    parseInt(
                        fila.querySelector("input").value || 0
                    );

                let alimento =
                    alimentos.find(
                        x => x.id == alimentoId
                    );

                if(alimento)
                {
                    total += alimento.precio * cantidad;
                }
            });

        document.querySelectorAll("#tablaBebidas tbody tr")
            .forEach(fila =>
            {
                let bebidaId =
                    parseInt(
                        fila.querySelector("select").value
                    );

                let cantidad =
                    parseInt(
                        fila.querySelector("input").value || 0
                    );

                let bebida =
                    bebidas.find(
                        x => x.id == bebidaId
                    );

                if(bebida)
                {
                    total += bebida.precio * cantidad;
                }
            });

        document.getElementById("Precio").value =
            total.toFixed(2);
    }

</script>