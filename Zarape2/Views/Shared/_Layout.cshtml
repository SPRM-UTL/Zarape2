@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string ctrl) => string.Equals(controller, ctrl, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}

<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zarape2</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
</head>
<body>
    <div class="app-wrapper" id="appWrapper">
        <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

        <aside class="sidebar" id="sidebar" aria-label="Menú principal">
            <div class="sidebar-header">
                <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                    <span class="sidebar-brand-icon">
                        <i class="bi bi-shop-window"></i>
                    </span>
                    <span class="sidebar-brand-text">
                        <span class="sidebar-brand-name">Zarape2</span>
                        <span class="sidebar-brand-tagline">Restaurant POS</span>
                    </span>
                </a>
                <button type="button" class="sidebar-close d-lg-none" id="sidebarClose" aria-label="Cerrar menú">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <nav class="sidebar-nav">
                <p class="sidebar-section-label">Principal</p>
                <ul class="sidebar-menu">
                    <li>
                        <a class="sidebar-link @Active("Home")" asp-controller="Home" asp-action="Index" title="Inicio">
                            <span class="sidebar-link-icon"><i class="bi bi-house-door"></i></span>
                            <span class="sidebar-link-text">Inicio</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link @Active("Comanda")" asp-controller="Comanda" asp-action="Index" title="Comandas">
                            <span class="sidebar-link-icon"><i class="bi bi-receipt-cutoff"></i></span>
                            <span class="sidebar-link-text">Comandas</span>
                        </a>
                    </li>
                </ul>

                <p class="sidebar-section-label">Catálogo</p>
                <ul class="sidebar-menu">
                    <li>
                        <a class="sidebar-link @Active("Alimento")" asp-controller="Alimento" asp-action="Index" title="Alimentos">
                            <span class="sidebar-link-icon"><i class="bi bi-egg-fried"></i></span>
                            <span class="sidebar-link-text">Alimentos</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link @Active("Bebida")" asp-controller="Bebida" asp-action="Index" title="Bebidas">
                            <span class="sidebar-link-icon"><i class="bi bi-cup-hot-fill"></i></span>
                            <span class="sidebar-link-text">Bebidas</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link @Active("Combo")" asp-controller="Combo" asp-action="Index" title="Combos">
                            <span class="sidebar-link-icon"><i class="bi bi-box2-heart-fill"></i></span>
                            <span class="sidebar-link-text">Combos</span>
                        </a>
                    </li>
                </ul>

                <p class="sidebar-section-label">Administración</p>
                <ul class="sidebar-menu">
                    <li>
                        <a class="sidebar-link @Active("Usuarios")" asp-controller="Usuarios" asp-action="Index" title="Usuarios">
                            <span class="sidebar-link-icon"><i class="bi bi-people-fill"></i></span>
                            <span class="sidebar-link-text">Usuarios</span>
                        </a>
                    </li>
                    <li>
                        <a class="sidebar-link @Active("Sucursales")" asp-controller="Sucursales" asp-action="Index" title="Sucursales">
                            <span class="sidebar-link-icon"><i class="bi bi-geo-alt-fill"></i></span>
                            <span class="sidebar-link-text">Sucursales</span>
                        </a>
                    </li>
                </ul>
            </nav>

            <div class="sidebar-footer d-none d-lg-block">
                <button type="button" class="sidebar-collapse-btn" id="sidebarCollapseBtn" aria-label="Contraer menú">
                    <i class="bi bi-layout-sidebar-inset"></i>
                    <span>Contraer panel</span>
                </button>
            </div>
        </aside>

        <div class="main-content" id="mainContent">
            <header class="topbar">
                <div class="topbar-left">
                    <button type="button" class="topbar-toggle" id="sidebarOpenBtn" aria-label="Abrir menú">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="topbar-heading">
                        <h1 class="topbar-title">@ViewData["Title"]</h1>
                        <p class="topbar-subtitle mb-0">Panel de gestión Zarape2</p>
                    </div>
                </div>
                <div class="topbar-right">
                    <span class="topbar-badge">
                        <i class="bi bi-circle-fill"></i>
                        Sistema activo
                    </span>
                </div>
            </header>

            <main role="main" class="page-content">
                <div class="page-content-inner">
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
