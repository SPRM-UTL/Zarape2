@model List<Zarape2.Models.Comanda>

@{
    ViewData["Title"] = "Comandas";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
                Regresar
            </a>
        </div>

        <h2 class="mb-0">Registro de Comandas</h2>

        <button type="button"
                class="btn btn-success"
                data-bs-toggle="modal"
                data-bs-target="#modalComanda">
            Nueva Comanda
        </button>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            Lista de Comandas
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Folio</th>
                            <th>Mesa</th>
                            <th>Sucursal</th>
                            <th>Fecha</th>
                            <th>Productos</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th width="220">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            @foreach (var comanda in Model)
                            {
                                <tr>

                                    <td>
                                        #@comanda.Id
                                    </td>

                                    <td>
                                        Mesa @comanda.Mesa
                                    </td>

                                    <td>
                                        @comanda.Sucursal?.Nombre
                                    </td>

                                    <td>
                                        @comanda.Fecha.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @(comanda.Detalles?.Count ?? 0)
                                    </td>

                                    <td>
                                        <strong>
                                            $@comanda.Total.ToString("N2")
                                        </strong>
                                    </td>

                                    <td>

                                        @if (comanda.Estado == "Abierta")
                                        {
                                            <span class="badge bg-primary">
                                                Abierta
                                            </span>
                                        }
                                        else if (comanda.Estado == "Preparacion")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Preparación
                                            </span>
                                        }
                                        else if (comanda.Estado == "Entregada")
                                        {
                                            <span class="badge bg-info">
                                                Entregada
                                            </span>
                                        }
                                        else if (comanda.Estado == "Pagada")
                                        {
                                            <span class="badge bg-success">
                                                Pagada
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Cancelada
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <button class="btn btn-info btn-sm"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#detalle_@comanda.Id">
                                            Ver Detalle
                                        </button>

                                    </td>

                                </tr>

                                <tr class="collapse" id="detalle_@comanda.Id">

                                    <td colspan="9">

                                        <div class="card">

                                            <div class="card-header">
                                                Detalle de Comanda #@comanda.Id
                                            </div>

                                            <div class="card-body">

                                                <table class="table table-bordered table-sm">

                                                    <thead>

                                                        <tr>
                                                            <th>Tipo</th>
                                                            <th>Descripción</th>
                                                            <th>Cantidad</th>
                                                            <th>Precio</th>
                                                            <th>Importe</th>
                                                            <th>Observaciones</th>
                                                        </tr>

                                                    </thead>

                                                    <tbody>

                                                        @if (comanda.Detalles != null && comanda.Detalles.Any())
                                                        {
                                                            @foreach (var detalle in comanda.Detalles)
                                                            {
                                                                <tr>

                                                                    <td>
                                                                        @detalle.TipoProducto
                                                                    </td>

                                                                    <td>
                                                                        @detalle.Descripcion
                                                                    </td>

                                                                    <td>
                                                                        @detalle.Cantidad
                                                                    </td>

                                                                    <td>
                                                                        $@detalle.PrecioUnitario.ToString("N2")
                                                                    </td>

                                                                    <td>
                                                                        $@detalle.Importe.ToString("N2")
                                                                    </td>

                                                                    <td>
                                                                        @detalle.Observaciones
                                                                    </td>

                                                                </tr>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <tr>
                                                                <td colspan="6" class="text-center">
                                                                    Sin productos.
                                                                </td>
                                                            </tr>
                                                        }

                                                    </tbody>

                                                    <tfoot>

                                                        <tr>

                                                            <th colspan="4"
                                                                class="text-end">
                                                                Total
                                                            </th>

                                                            <th>
                                                                $@comanda.Total.ToString("N2")
                                                            </th>

                                                            <th></th>

                                                        </tr>

                                                    </tfoot>

                                                </table>

                                            </div>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center">
                                    No hay comandas registradas.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- Modal -->
<div class="modal fade" id="modalComanda" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <form asp-action="Agregar" method="post">

                <div class="modal-header">
                    <h5 class="modal-title">
                        Nueva Comanda
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="row">

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Mesa</label>

                            <input type="number"
                                   name="Mesa"
                                   class="form-control"
                                   required />
                        </div>

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Sucursal</label>

                            <select name="SucursalId"
                                    class="form-select"
                                    required>

                                <option value="">Seleccione...</option>

                                @foreach (var sucursal in ViewBag.Sucursales)
                                {
                                    <option value="@sucursal.Id">
                                        @sucursal.Nombre
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Estado</label>

                            <select name="Estado"
                                    class="form-select">

                                <option value="Abierta">Abierta</option>
                                <option value="Preparacion">Preparación</option>
                                <option value="Entregada">Entregada</option>
                                <option value="Pagada">Pagada</option>
                                <option value="Cancelada">Cancelada</option>

                            </select>
                        </div>

                    </div>

                    <hr />

                    <div class="d-flex justify-content-between mb-3">

                        <h5>Detalle</h5>

                        <button type="button"
                                class="btn btn-primary"
                                onclick="agregarDetalle()">
                            Agregar Producto
                        </button>

                    </div>

                    <table class="table table-bordered" id="tablaDetalles">

                        <thead class="table-dark">

                            <tr>
                                <th>Tipo</th>
                                <th>Producto</th>
                                <th>Precio</th>
                                <th>Cantidad</th>
                                <th>Importe</th>
                                <th>Observaciones</th>
                                <th></th>
                            </tr>

                        </thead>

                        <tbody>
                        </tbody>

                    </table>

                    <div class="text-end">

                        <h4>
                            Total:
                            $<span id="lblTotal">0.00</span>
                        </h4>

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        Guardar Comanda
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

<script>

    let indice = 0;

    const alimentos = [
        @foreach (var item in ViewBag.Alimentos)
        {
                @: { id:@item.Id, nombre:"@item.Nombre", precio:@item.Precio },
        }
    ];

    const bebidas = [
        @foreach (var item in ViewBag.Bebidas)
        {
            Console.WriteLine(@item.Id);
                @: { id:@item.Id, nombre:"@item.Nombre", precio:@item.Precio },
        }
    ];

    const combos = [
        @foreach (var item in ViewBag.Combos)
        {
                @: { id:@item.Id, nombre:"@item.Nombre", precio:@item.Precio },
        }
    ];

    function agregarDetalle()
    {
        let fila = document.createElement("tr");

        fila.innerHTML = `
            <td>
                <select class="form-select"
                        name="Detalles[${indice}].TipoProducto"
                        onchange="cargarProductos(this, ${indice})">

                    <option value="Alimento">Alimento</option>
                    <option value="Bebida">Bebida</option>
                    <option value="Combo">Combo</option>

                </select>
            </td>

            <td>
                <select class="form-select producto"
                        name="Detalles[${indice}].ProductoId"
                        onchange="actualizarPrecio(this)">
                </select>
            </td>

            <td>
                <input type="number"
                       class="form-control precio"
                       step="0.01"
                       readonly
                       name="Detalles[${indice}].PrecioUnitario" />
            </td>

            <td>
                <input type="number"
                       class="form-control cantidad"
                       step="1"
                       value="1"
                       name="Detalles[${indice}].Cantidad"
                       oninput="calcularFila(this)" />
            </td>

            <td>
                <input type="number"
                       class="form-control importe"
                       readonly
                       step="0.01"
                       name="Detalles[${indice}].Importe" />
            </td>

            <td>
                <input type="text"
                       class="form-control"
                       name="Detalles[${indice}].Observaciones" />
            </td>

            <td>
                <button type="button"
                        class="btn btn-danger"
                        onclick="eliminarFila(this)">
                    X
                </button>
            </td>
        `;

        document.querySelector("#tablaDetalles tbody")
            .appendChild(fila);

        cargarProductos(
            fila.querySelector("select"),
            indice
        );

        indice++;
    }

    function cargarProductos(selectTipo, indiceFila)
    {
        let fila = selectTipo.closest("tr");

        let productoSelect =
            fila.querySelector(".producto");

        productoSelect.innerHTML = "";

        let lista = [];

        if(selectTipo.value === "Alimento")
            lista = alimentos;

        if(selectTipo.value === "Bebida")
            lista = bebidas;

        if(selectTipo.value === "Combo")
            lista = combos;

        lista.forEach(x =>
        {
            let option =
                document.createElement("option");

            option.value = x.id;
            option.text = x.nombre;
            option.dataset.precio = x.precio;

            productoSelect.appendChild(option);
        });

        actualizarPrecio(productoSelect);
    }

    function actualizarPrecio(selectProducto)
    {
        let fila = selectProducto.closest("tr");

        let precio =
            selectProducto.options[
                selectProducto.selectedIndex
            ].dataset.precio;

        fila.querySelector(".precio").value =
            parseFloat(precio).toFixed(2);

        calcularFila(
            fila.querySelector(".cantidad")
        );
    }

    function calcularFila(inputCantidad)
    {
        let fila = inputCantidad.closest("tr");

        let precio =
            parseFloat(
                fila.querySelector(".precio").value || 0
            );

        let cantidad =
            parseFloat(
                fila.querySelector(".cantidad").value || 0
            );

        let importe = precio * cantidad;

        fila.querySelector(".importe").value =
            importe.toFixed(2);

        calcularTotal();
    }

    function calcularTotal()
    {
        let total = 0;

        document
            .querySelectorAll(".importe")
            .forEach(x =>
            {
                total += parseFloat(x.value || 0);
            });

        document.getElementById("lblTotal")
            .innerText = total.toFixed(2);
    }

    function eliminarFila(btn)
    {
        btn.closest("tr").remove();
        calcularTotal();
    }

</script>